-- 9 Читаем посты и названия категорий
SELECT p.id, p.slug, p.title, p.create_at, p.likes, p.view_count, c.name
FROM posts AS p
JOIN categories AS c ON c.id = p.category_id;

-- 10 JOIN и получение данных многие ко многим
SELECT p.id AS post_id, p.title AS post_title, h.id AS tag_id, h.title AS tag_title
FROM posts AS p
JOIN posts_hashtags AS ph ON ph.post_id = p.id
JOIN hashtags AS h ON h.id = ph.hashtag_id
ORDER By p.id, h.id;

-- 11 И посты и категории и хештеги
SELECT p.id AS post_id, p.title AS post_title, h.id AS tag_id, h.title AS tag_title, c.name AS category_name
FROM posts AS p
JOIN posts_hashtags AS ph ON ph.post_id = p.id
JOIN hashtags AS h ON h.id = ph.hashtag_id
JOIN categories AS c ON p.category_id = c.id
ORDER By p.id, h.id;


-- 12 И посты и категории и хештеги и группировка по post_id
SELECT p.id AS post_id, p.title AS post_title, h.id AS tag_id, h.title AS tag_title, c.name AS category_name
FROM posts AS p
JOIN posts_hashtags AS ph ON ph.post_id = p.id
JOIN hashtags AS h ON h.id = ph.hashtag_id
JOIN categories AS c ON p.category_id = c.id
GROUP BY post_id
ORDER By p.id, h.id;

-- 13 И посты и категории и хештеги и группировка по post_id решаю проблему того что показывается ТОЛЬКО один тег на "ГРУППУ" поста GROUP CONCAT - выведет все записи Тегов через запятую для этого поста
SELECT p.id AS post_id, p.title AS post_title, h.id AS tag_id, group_concat(h.title, ", ") AS tag_title, c.name AS category_name
FROM posts AS p
JOIN posts_hashtags AS ph ON ph.post_id = p.id
JOIN hashtags AS h ON h.id = ph.hashtag_id
JOIN categories AS c ON p.category_id = c.id
GROUP BY post_id
ORDER By p.id, h.id;

-- 14 Получить все теги одного поста
SELECT h.id, h.title AS tag_title, p.id
FROM posts AS p
JOIN posts_hashtags AS ph ON ph.post_id = p.id
JOIN hashtags AS h ON ph.hashtag_id = h.id
WHERE p.id = 1;

-- 15 Получить все посты одного тега
SELECT p.id AS post_id, p.title AS post_title, h.title AS tag_title
FROM hashtags AS h
JOIN posts_hashtags AS ph ON h.id = ph.hashtag_id
JOIN posts AS p ON ph.post_id = p.id
WHERE h.id = 1;

