SELECT * FROM MarvelCharacters;

SELECT name, eye, hair, sex, appearances, year
FROM MarvelCharacters;

-- SELECT - отвечает за то, какие столбцы вы увидите
-- FROM - из какой таблицы
-- WHERE - условия фильтрации
-- AND, OR, NOT, IN, BETWEEN LIKE = < > != оператор
-- ORDER - порядок сортировки - можно указать ресколько признаков, есть DESC - по убыванию (по умолчанию стоит ASK)


-- Персонажи с 39 по 45 включительно
SELECT name, appearances, year
FROM MarvelCharacters
WHERE year BETWEEN 1930 AND 1945
AND appearances > 10
ORDER BY year, appearances DESC;

--PRACTICE - попробуйте убрать из выборки персонажей с количеством появлений менее 10

-- LIKE - оператор для поиска ПОХОЖЕГО
-- Поддерживает маски

SELECT name, appearances, year
FROM MarvelCharacters
WHERE name LIKE "% man %"
OR name LIKE "%-man%";


