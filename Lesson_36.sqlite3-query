-- Список уникальных значений
SELECT DISTINCT SEX
FROM MarvelCharacters;

SELECT name, align, appearances, year, sex
FROM MarvelCharacters
WHERE sex = "Female Characters"
AND align LIKE "%bad%"
ORDER BY appearances DESC
LIMIT 5;


SELECT name, align, appearances, year, sex
FROM MarvelCharacters
WHERE sex != "Female Characters"
AND align LIKE "%bad%"
ORDER BY appearances DESC
LIMIT 5;

-- Все персоонажи за вычитом традиционного пола и неуказанного пола
SELECT name, align, appearances, year, sex
FROM MarvelCharacters
WHERE sex NOT IN ('Male Characters', 'Female Characters') 
AND SEX IS NOT NULL
ORDER BY appearances DESC;


SELECT DISTINCT EYE
FROM MarvelCharacters;

SELECT EYE
FROM MarvelCharacters
GROUP BY EYE;

SELECT EYE AS "Цвет глаз", COUNT(*) AS "Героев"
FROM MarvelCharacters
GROUP BY EYE
ORDER BY "Героев" DESC;


SELECT EYE AS "Цвет глаз", COUNT(*) AS "Героев"
FROM MarvelCharacters
WHERE EYE IS NOT Null
GROUP BY EYE
ORDER BY "Героев" DESC

