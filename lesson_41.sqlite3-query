-- Сначала категории. ПОтому что на них будут ссылатся посты
CREATE TABLE IF NOT EXISTS categories (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    slug TEXT UNIQUE NOT NULL
);

CREATE TABLE IF NOT EXISTS posts (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    slug TEXT UNIQUE NOT NULL,
    category_id INTEGER REFERENCES categories(id) ON DELETE RESTRICT,
    create_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    likes INTEGER DEFAULT 0,
    view_count INTEGER DEFAULT 0)

--     Действие	Что происходит
-- NO ACTION	запрещает нарушение связи, это поведение по умолчанию
-- RESTRICT	сразу запрещает удалить/изменить родителя, если есть связанные строки
-- CASCADE	действие переносится на дочерние строки
-- SET NULL	внешний ключ становится NULL
-- SET DEFAULT	внешний ключ получает DEFAULT