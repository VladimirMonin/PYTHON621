SELECT posts.title, posts.content, posts.slug, categories.name AS category_name
FROM posts
JOIN categories ON posts.category_id = categories.id;


SELECT posts.title, posts.content, posts.slug, posts_hashtags.post_id, posts_hashtags.hashtag_id
FROM posts
JOIN posts_hashtags ON posts.id = posts_hashtags.post_id;


SELECT posts.title, posts.content, posts.slug, posts_hashtags.post_id, posts_hashtags.hashtag_id, hashtags.title
FROM posts
JOIN posts_hashtags ON posts.id = posts_hashtags.post_id
JOIN hashtags ON posts_hashtags.hashtag_id = hashtags.id;


SELECT posts.title, posts.content, posts.slug, group_concat(hashtags.title, ', ') as tags
FROM posts
JOIN posts_hashtags ON posts.id = posts_hashtags.post_id
JOIN hashtags ON posts_hashtags.hashtag_id = hashtags.id
GROUP BY posts.id